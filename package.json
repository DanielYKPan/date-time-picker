{
  "name": "date-time-picker-app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build picker && node -e \"['README.md','LICENSE'].forEach(f => fs.copyFileSync(f, 'dist/picker/' + f))\"",
    "build:css": "sass --style=compressed projects/picker/src/sass/picker.scss dist/picker/assets/style/picker.min.css",
    "test": "ng test picker",
    "test:ci": "ng test picker --watch=false --no-progress --coverage",
    "lint": "ng lint",
    "npm_pack": "cd dist/picker && npm pack",
    "package": "npm run build:lib && npm run build:css && npm run npm_pack"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
